# Server Port (Render sets this dynamically)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=production

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/myjourney?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/myjourney?retryWrites=true&w=majority

# JWT Signing Secret (minimum 32 characters)
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Allowed Frontend URL for CORS (your Vercel app domain)
# Example: https://yatrasetu.vercel.app
CLIENT_ORIGIN=https://YOUR-FRONTEND-APP.vercel.app

# Cross-origin cookies (true in production over HTTPS)
COOKIE_SECURE=true

# Default password for seeded demo accounts (admin, operators, demo customer)
DEMO_SEED_PASSWORD=Password@123
